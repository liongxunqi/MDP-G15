# ─── STM32 Serial ────────────────────────────────────────────────────────────
# Check with: ls /dev/ttyACM* or ls /dev/ttyUSB*
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200

# ─── Network ─────────────────────────────────────────────────────────────────
# RPI_HOST: IP address the RPi binds to for incoming PC connection
# Set this to the RPi's own IP on your WiFi hotspot network
RPI_HOST=192.168.15.15
RPI_PORT=5000

# ─── Bluetooth ───────────────────────────────────────────────────────────────
BT_PORT=1

# ─── Task 1 Timing Tuning ────────────────────────────────────────────────────
# How long (seconds) to wait after STM OK before sending next segment
SEGMENT_DELAY_S=0.5
# How many times to retry DETECT if PC doesn't respond
DETECT_RETRY_COUNT=1
# Delay between retries
DETECT_RETRY_DELAY_S=0.2
# Timeout waiting for PC OBJECT response per attempt
DETECT_TIMEOUT_S=0.5
# Debounce: seconds after last obstacle before auto-sending to PC for path calc
DEBOUNCE_DELAY_S=1.0

# ─── Checklist A.5 (task_a5.py) ──────────────────────────────────────────────
# Camera standoff in cm. The script asks the firmware for this + 1.3 cm,
# because the ultrasound reads about 1.3 cm long on every pass.
A5_STANDOFF_CM=25
# Anything further ahead than this is a wall, not the obstacle — refuse to run.
A5_MAX_APPROACH_CM=150
# A block has four faces; a fifth leg would drive back to where you started.
A5_MAX_FACES=4
# Second confidence gate, on top of the 0.25 floor inside detect.py.
A5_MIN_CONFIDENCE=0.55
# Seconds to let the chassis stop rocking before FU takes its standing reading.
A5_SETTLE_S=0.3
# Arc profile A5_ORBIT was traced for: 0 TIGHT (r=291mm, the firmware default),
# 1 CLEAN (318mm), 2 SLOW (306mm). task_a5.py checks ?STAT against this and
# warns on a mismatch; it never changes the profile itself.
A5_ARC_PROFILE=0
# One face to the next. Traced for a 291 mm (TIGHT) arc radius — retrace it if
# you change profile. See the comment on ORBIT_LINE in task_a5.py.
A5_ORBIT=R20,FR90,FL90,R37,FL90

# How long to wait for the PC's PATH before calling it a failure.
# The planner is an exhaustive tour search with an A* per edge; a slow
# laptop is not a broken one. On timeout the Pi sends STATUS,FAILED and
# allows a retry, instead of standing still with nothing on screen.
PATH_TIMEOUT_S=30.0
