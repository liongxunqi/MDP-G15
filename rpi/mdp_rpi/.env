# ─── STM32 Serial ────────────────────────────────────────────────────────────
# Check with: ls /dev/ttyACM* or ls /dev/ttyUSB*
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200

# ─── Network ─────────────────────────────────────────────────────────────────
# RPI_HOST: IP address the RPi binds to for incoming PC connection
# Set this to the RPi's own IP on your WiFi hotspot network
RPI_HOST=192.168.15.15
RPI_PORT=5000

# ─── Bluetooth ───────────────────────────────────────────────────────────────
BT_PORT=1

# ─── Task 1 Timing Tuning ────────────────────────────────────────────────────
# How long (seconds) to wait after STM OK before sending next segment
SEGMENT_DELAY_S=0.5
# How many times to retry DETECT if PC doesn't respond
DETECT_RETRY_COUNT=1
# Delay between retries
DETECT_RETRY_DELAY_S=0.2
# Timeout waiting for PC OBJECT response per attempt
DETECT_TIMEOUT_S=30.0
# Debounce: seconds after last obstacle before auto-sending to PC for path calc
DEBOUNCE_DELAY_S=1.0

# Wait for each STM instruction to finish, then use measured position/heading
# feedback to decide whether Task 1 can continue or must re-plan.
TASK1_FEEDBACK_WAIT=1
TASK1_FEEDBACK_TIMEOUT_S=7.0
TASK1_IR_FEEDBACK=1
TASK1_GYRO_SETTLE=1
TASK1_GYRO_SETTLE_RATE_DPS=1.0
TASK1_GYRO_SETTLE_SAMPLES=3
TASK1_GYRO_SETTLE_TIMEOUT_S=1.0
TASK1_CAPTURE_SETTLE_S=2.0
TASK1_US_ADJUST_RETRIES=3
TASK1_US_ADJUST_TOLERANCE_CM=3.0
TASK1_US_ADJUST_MAX_STEP_CM=30
TASK1_US_SETTLE_S=0.2
TASK1_PHOTO_RETRY_STANDOFFS=40,45,35,33,20
TASK1_PHOTO_RETRY_LIMIT=5

# --- Checklist A.5: navigate around the obstacle (task_a5.py) ----------------
# Camera standoff in cm. FU is asked for this + 1.3 to cancel the ultrasonic's
# systematic long read, so 45 here really does park the robot at ~45 cm.
A5_STANDOFF_CM=45
# Compact the orbit by this amount. It is absorbed into the route distances,
# avoiding a wasteful FU26 immediately followed by R26.
A5_ORBIT_INSET_CM=20
# Wait for chassis/camera-mount vibration to stop before each photograph.
A5_CAPTURE_SETTLE_S=2.0
# Anything further than this ahead is not the obstacle - refuse to approach it.
A5_MAX_APPROACH_CM=150
# Faces to try before giving up. A block has four.
A5_MAX_FACES=4
# Detector running on the PC via pc_side/test_pc_server.py.
A5_PC_IP=192.168.15.26
A5_PC_PORT=5001
A5_PC_TIMEOUT_S=30.0
# Orbit geometry for profile 0 TIGHT (29.1 cm radius) at 25 cm sensor standoff.
# TIGHT is the only profile - the firmware is locked to it.
A5_OBSTACLE_SIZE_CM=10
A5_ORBIT_BACKUP_CM=20
A5_REAR_AXLE_TO_SENSOR_CM=23
# Measured floor correction: the uncorrected orbit stopped 10 cm before the
# centreline of the next face. This advances only the around-obstacle axis.
# MEASURED ON CLEAN - re-check on TIGHT.
A5_ORBIT_ADVANCE_CORRECTION_CM=10
# Shift the two outer arcs away from the box, then remove the same distance
# from the final reverse so the final 45 cm viewing pose remains unchanged.
A5_ORBIT_CLEARANCE_CM=15
A5_ORBIT_FR_DEG=90
A5_ORBIT_FL_DEG=90
# Heading is corrected by the firmware carry-over now, not by a correction
# arc from here. ?HDG is logged after each orbit; above this it warns loudly.
A5_ORBIT_HEADING_WARN_DEG=1.0
# The floor-tuned CLEAN route was R6,FR90,F15,FL90,F5,FL90,R6. Moved to TIGHT by
# keeping each floor-tuned offset from the CLEAN geometry and applying it to
# the TIGHT geometry (derived R20,FR90,F15,FL90,R4,FL90,R9): the middle leg is
# 17 cm further forward than derived, the last reverse unchanged. A STARTING
# POINT, NOT A MEASUREMENT - walk one orbit and adjust the middle F and last R.
A5_ORBIT=R6,FR90,F15,FL90,F13,FL90,R9

# --- Calibration (communications/cal_profile.py) -----------------------------
# The profile every task restores and freezes at startup. Make it with
#   python3 calibrate.py guided arena --note "..."
# and check it before a run with  python3 calibrate.py verify arena
CAL_PROFILE=tr15
# 1 = refuse to start without CAL_PROFILE. 0 = run on compiled seeds (bench only).
CAL_REQUIRED=1

# Calibration - Task 2 refuses to start without it
T2T_CAL_PROFILE=tr00
T2T_RADIUS_CM=34.0
T2T_FAST=1

# Camera position for the stage-2 view (provisional, measure on the robot)
T2_CAMERA_FROM_AXLE_CM=12.5
T2_ARROW_TIMEOUT_S=8
T2_EXPOSURE_US=5000

# --- gordon (task2mn_gordon) -------------------------------------------------
# Step 2a: how far it rolls after RST at fast speed, cm (measured)
#T2G_RST_COAST_FAST_CM=26.5
# Step 5: steering swing time, s - must match MOTION_STEER_SLEW_S in motion.h
T2G_STEER_SLEW_S=0.08
# Protocol 10 speeds, x10 rpm. Keep arcs at 15 until the radius at other
# speeds has been measured.
T2G_ARC_V=15
T2G_STRAIGHT_V=20
T2G_SCAN_V=15
