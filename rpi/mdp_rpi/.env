# ─── STM32 Serial ────────────────────────────────────────────────────────────
# Check with: ls /dev/ttyACM* or ls /dev/ttyUSB*
SERIAL_PORT=/dev/ttyACM0
BAUD_RATE=115200

# ─── Network ─────────────────────────────────────────────────────────────────
# RPI_HOST: IP address the RPi binds to for incoming PC connection
# Set this to the RPi's own IP on your WiFi hotspot network
RPI_HOST=192.168.15.15
RPI_PORT=5000

# ─── Bluetooth ───────────────────────────────────────────────────────────────
BT_PORT=1

# ─── Task 1 Timing Tuning ────────────────────────────────────────────────────
# How long (seconds) to wait after STM OK before sending next segment
SEGMENT_DELAY_S=0.5
# How many times to retry DETECT if PC doesn't respond
DETECT_RETRY_COUNT=1
# Delay between retries
DETECT_RETRY_DELAY_S=0.2
# Timeout waiting for PC OBJECT response per attempt
DETECT_TIMEOUT_S=0.5
# Debounce: seconds after last obstacle before auto-sending to PC for path calc
DEBOUNCE_DELAY_S=1.0

# --- Checklist A.5: navigate around the obstacle (task_a5.py) ----------------
# Camera standoff in cm. FU is asked for this + 1.3 to cancel the ultrasonic's
# systematic long read, so 45 here really does park the robot at ~45 cm.
A5_STANDOFF_CM=45
# Compact the orbit by this amount. It is absorbed into the route distances,
# avoiding a wasteful FU26 immediately followed by R26.
A5_ORBIT_INSET_CM=20
# Wait for chassis/camera-mount vibration to stop before each photograph.
A5_CAPTURE_SETTLE_S=2.0
# Anything further than this ahead is not the obstacle - refuse to approach it.
A5_MAX_APPROACH_CM=150
# Faces to try before giving up. A block has four.
A5_MAX_FACES=4
# Detector running on the PC via pc_side/test_pc_server.py.
A5_PC_IP=192.168.15.26
A5_PC_PORT=5001
A5_PC_TIMEOUT_S=30.0
# Orbit geometry for profile 1 CLEAN (31.8 cm radius) at 25 cm sensor standoff.
A5_ARC_PROFILE=1
A5_OBSTACLE_SIZE_CM=10
A5_ORBIT_BACKUP_CM=20
A5_REAR_AXLE_TO_SENSOR_CM=23
# Measured floor correction: the uncorrected orbit stopped 10 cm before the
# centreline of the next face. This advances only the around-obstacle axis.
A5_ORBIT_ADVANCE_CORRECTION_CM=10
# Shift the two outer arcs away from the box, then remove the same distance
# from the final reverse so the final 45 cm viewing pose remains unchanged.
A5_ORBIT_CLEARANCE_CM=15
A5_ORBIT_FR_DEG=90
A5_ORBIT_FL_DEG=90
# Optional A5-only command biases. Leave at zero because measured turns vary
# from about 83-97 degrees; ?TURN feedback below corrects every arc instance.
A5_ORBIT_FR_COMMAND_OFFSET_DEG=0
A5_ORBIT_FL_COMMAND_OFFSET_DEG=0
A5_ORBIT_RR_COMMAND_OFFSET_DEG=0
A5_ORBIT_RL_COMMAND_OFFSET_DEG=0
# Add the signed result of every arc, then correct once after the complete
# orbit segment. Angle mismatch never halts A5.
A5_ORBIT_HEADING_TOLERANCE_DEG=2
A5_ORBIT_MAX_CORRECTION_DEG=10
# Commands below 5 degrees only turn the steering wheels; the chassis does not move.
A5_ORBIT_MIN_CORRECTION_DEG=5
A5_ORBIT_MAX_CORRECTIONS=1
A5_ORBIT_CORRECTION_COAST_DEG=3.5
# Compact equivalent of the intended floor-tuned 45 cm route with middle F25.
# The old FU26,R26 pair is combined into R6; F25 becomes F5 and the final R26
# becomes R6. task_a5.py then sends R20 to restore the 45 cm camera pose.
A5_ORBIT=R6,FR90,F15,FL90,F5,FL90,R6
